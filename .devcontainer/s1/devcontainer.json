{
  "name": "Field Agents: Season 1 (Operation Juice Shop)",
  // Built and published from .devcontainer/image by the private ctf-hq repo.
  // v2 adds the nginx front, Juice Shop source, deploy-shop, and the K7 canary.
  // v3 adds the Claude API SDK and Agent SDK for the Console missions (P1 to P5).
  "image": "ghcr.io/fieldagentlabs/fa-lab:v3",
  "hostRequirements": { "cpus": 2 },
  // SSH lets `gh codespace ssh` work (maintainer tests, and players who prefer a local terminal).
  "features": {
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  },
  "forwardPorts": [80, 3000],
  "portsAttributes": {
    "80": { "label": "Shop via nginx (logged)", "onAutoForward": "notify" },
    "3000": { "label": "Juice Shop direct", "onAutoForward": "silent" }
  },
  "postCreateCommand": "sudo ln -sf ${containerWorkspaceFolder}/platform/control/control.py /usr/local/bin/control && init-juice-shop-src",
  "postStartCommand": "start-shop",
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Optional. Your own Claude Console API key, with a spending limit set. Not needed if you sign in to Claude Code with a Claude plan."
    }
  },
  "customizations": {
    "codespaces": { "openFiles": ["safehouse/README.md"] },
    // The file list shows only safehouse/ and this season's missions (data, P4's bot).
    // Maintainer files, graders (verify/), and the other season are hidden, not removed: the
    // terminal, control verify, and Claude Code's lab context (root CLAUDE.md) still work.
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
      // No Source Control panel: players never commit here (a push would make a public fork), and the
      // repo's commit history isn't theirs. git still works in the terminal.
      "git.enabled": false,
      "files.exclude": {
        ".devcontainer": true, ".github": true, "platform": true, "tools": true,
        ".gitignore": true, "CONTRIBUTING.md": true, "CLAUDE.md": true, "README.md": true,
        "**/verify": true, "seasons/s0-the-farm": true
      }
      }
    }
  }
}
